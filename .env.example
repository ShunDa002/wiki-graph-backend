OPENROUTER_API_KEY="api-key-here"
OPENROUTER_MODEL="model-name-here"

WIKI_REPO_DIR=./data/source-repo
WIKI_DIR=./data/source-repo/wiki
GRAPH_OUTPUT_PATH=./data/generated/graph.json
GRAPH_CACHE_ENABLED=true
GRAPH_WRITE_SNAPSHOT=true
GRAPH_INCLUDE_DRAFTS=true
GRAPH_INCLUDE_DEPRECATED=false
GRAPH_EXCERPT_LENGTH=240
GRAPH_MAX_FILE_BYTES=2097152
GRAPH_MAX_NODES=10000
GRAPH_REBUILD_SECRET_KEY="change-me"
FRONTEND_ORIGIN=["http://localhost:3000", "http://localhost:3001"]
GRAPH_SOURCE_FOLDERS=["sources","concepts"]
CHAT_SOURCE_FOLDERS=["sources","concepts"]
CHAT_TOP_K=4
CHAT_MAX_PAGE_CHARS=12000
CHAT_MAX_TOTAL_CONTEXT_CHARS=35000
WIKI_RELOAD_API_KEY="change-me"

REPOSITORY_URL="repo-url-here"